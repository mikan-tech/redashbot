{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "moduleResolution": "node",
    "module": "CommonJS",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "outDir": ".build",
    "allowJs": true,
    "sourceMap": true,
    "rootDir": "./",
    "lib": ["ES2022"],
    "skipLibCheck": true
  },
  "include": ["src/*.ts", "*.ts"]
}
